# Cordada API. Copy to .env and fill in. Never commit .env.
PORT=8787

# Postgres (Neon, Supabase...). Leave empty to run an embedded Postgres (PGlite) in ./.data
DATABASE_URL=

# Front-end origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Signs personal links. Required in production: any long random string.
APP_SECRET=
# Key for Sherpas' servers (advisor brief), sent as x-api-key
SERVER_KEY=
# Hand out demo links at /v1/demo/households (on by default outside production)
DEMO_MODE=

# Sherpas hackathon: AI proxy and the cases MCP
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=

# ElevenLabs: live agent and voice
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_ID=eZxqQzb5CuYo3Kl6EXfZ
