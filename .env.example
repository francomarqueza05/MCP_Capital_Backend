# Cordada. Copy to .env and fill in. Never commit .env.

# Sherpas hackathon AI proxy: chat, Cordi's remarks and suggestions, narration voice
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=

# ElevenLabs: the live voice agent (and the narration voice when the proxy can't)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Cordi's voice: a Castilian Spanish voice on eleven v4 (expressive), the model it is fine-tuned
# for, so the accent holds. Every line is made with the same settings. The voice must live in
# the account of ELEVENLABS_API_KEY (ours: Raquel, Spanish, peninsular).
VOICE_ID=eZxqQzb5CuYo3Kl6EXfZ
VOICE_MODEL_LIVE=eleven-v4

# English (the default language). Optional: without them, the Spanish agent and voice speak English.
# A copy of the agent set to English with a native English voice, and that same voice here.
ELEVENLABS_AGENT_ID_EN=
VOICE_ID_EN=
