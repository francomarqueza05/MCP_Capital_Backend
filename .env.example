# Cordada: every key the app reads. Copy to .env for local work (never commit .env), and set
# the same names as Environment Variables in Vercel (Project → Settings → Environment
# Variables) for production. Only the server reads them; none reaches the browser.

# ── Required ──────────────────────────────────────────────────────────────────────────────
# Sherpas MCP: where the households come from (every case it lists). Read on the server and
# kept 10 minutes; if it can't be reached (an expired token), the copy bundled with the app
# stands in. /api/status says which one is in use ("cases": "mcp" or "bundled").
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=

# Sherpas hackathon AI proxy: Cordi's answers in the chat and on the call, its remarks, the
# suggested questions. Also a backup road for the voice.
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=

# ElevenLabs: Cordi's voice (every narrated line) and the live voice agent.
# The key must be from the account where VOICE_ID lives (Raquel is in our account), and
# ELEVENLABS_AGENT_ID must be an agent of that same account (the signed call URL is asked
# with this key).
ELEVENLABS_API_KEY=

# Cordi's voice: Raquel (Castilian Spanish, peninsular), on eleven v4, the model she is
# fine-tuned for, so the accent holds. Every line is made with the same settings.
VOICE_ID=1eHrpOW5l98cxiSRjbzJ
VOICE_MODEL_LIVE=eleven-v4

# ── Live call (optional) ──────────────────────────────────────────────────────────────────
# Without it, "Call" still works: the browser listens, and the answers use the voice above.
# Its own voice is set in the agent on ElevenLabs: use the same Raquel voice there too.
ELEVENLABS_AGENT_ID=

# ── English (optional) ────────────────────────────────────────────────────────────────────
# A native English voice, and a copy of the agent in English with that voice
# (scripts/agent-en.mjs makes it). Without them, Raquel speaks English too.
VOICE_ID_EN=
ELEVENLABS_AGENT_ID_EN=
# Set to 1 once the English agent speaks with the English voice (the script does it).
ELEVENLABS_AGENT_EN_READY=

# ── Tuning (optional) ─────────────────────────────────────────────────────────────────────
# Voice pace; 1 is natural (faster ran the sentences together).
VOICE_SPEED=1
